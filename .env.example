# Supabase project URL used by the SSR auth client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase anon/publishable key. Never use the service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Canonical web origin used for callback and metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Private FastAPI origin for server-side requests.
API_BASE_URL=http://127.0.0.1:8000
# Browser-call origin. Configure backend CORS before using browser-side API calls.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
