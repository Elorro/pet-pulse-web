# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project URL. Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon (publishable) key. Safe in the browser because RLS protects data.
# Must be the same project the FastAPI backend verifies tokens against.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical URL of this web app. Used for auth email redirects and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# FastAPI base URL (no trailing /api/v1), used for server-side calls and `pnpm gen:api`.
API_BASE_URL=http://localhost:8000

# Optional. FastAPI base URL for browser-side calls; requires CORS on FastAPI.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
